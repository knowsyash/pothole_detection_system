# okDRIVER Root .gitignore
# Environment & Secrets
.env
.env.local
.env.*.local
*.env

# Python & Virtual Environments
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
!frontend/lib/
!frontend/lib/**
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.coverage
htmlcov/

# Local SQLite & Databases
*.db
*.sqlite
*.sqlite3
okdriver_dev.db

# Uploaded Evidence (Local disk storage)
backend/uploads/evidence/*
!backend/uploads/evidence/.gitkeep
backend/uploads/
uploads/

# Node & Next.js
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/build/
node_modules/
.next/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# IDE & OS
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Antigravity artifacts & browser test runs
.gemini/
.tempmediaStorage/
scratchpad*.md
